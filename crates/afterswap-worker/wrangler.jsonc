// Pure-Rust rail Worker — a SECOND Worker, separate from the dashboard.
// Free-tier invariant: Workers Free + SQLite DO (same plan the dashboard's
// Scoreboard already runs on). No R2 binding by default — without it the
// Sequencer retains closed segments in SQLite (free-tier mode); uncomment
// the binding once the bucket exists (R2 has its own free tier: 10 GB,
// 1M class-A / 10M class-B per month — enablement may ask for a payment
// method on file even at $0 usage; verify at setup).
{
  "name": "afterswap-rail",
  "compatibility_date": "2026-08-01",
  "main": "build/worker/shim.mjs",
  "build": { "command": "cargo install -q worker-build && worker-build --release" },
  "durable_objects": {
    "bindings": [{ "name": "RAIL", "class_name": "RailSequencer" }]
  },
  // ⚠ Same deploy caveat as the dashboard: DO migrations must go through a
  // working `wrangler deploy`, confirmed with `wrangler deployments list`.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RailSequencer"] }],
  // The registered *public* attestation key. Not a secret — it is published
  // so auditors can verify. Rotated off the dev seed 2026-08-28; the private
  // seed lives with the executor only (see RAIL.md §7.2), never in git.
  "vars": { "RAIL_PUBKEY": "887e4537d43618b9d38b3b935cf0027543728863c1a893d0dcb641e9486c3451" }
  // "r2_buckets": [{ "binding": "RAIL_ARCHIVE", "bucket_name": "afterswap-rail-archive" }]
}
